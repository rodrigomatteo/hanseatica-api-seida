{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.ApplicationInsights"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning",
        "Hanseatica": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "Seida": {
    "BaseUrl": "https://e-seida.sunat.gob.pe/ol-ad-itseida-ws/",
    "NumeroRUC": "",
    "UsuarioSOL": "",
    "SolPassword": "",
    "TimeoutSeconds": 60,
    "ProxyEnabled": false,
    "ProxyAddress": "",
    "ProxyPort": 0,
    "ProxyUsername": "",
    "ProxyPassword": ""
  },
  "Authentication": {
    "Username": "",
    "Password": ""
  },
  "ExternalServices": {
    "SeidaBaseUrl": "https://e-seida.sunat.gob.pe/ol-ad-itseida-ws/"
  },
  "HealthChecks": {
    "DiskStorageThresholdPercentage": 90
  }
}
